---
import MainPageLayout from '@layouts/MainPageLayout.astro'
import Cover from '@components/Cover.astro'
import FabMenu from '@components/control/FabMenu.astro'
import ImageModule from '@components/misc/ImageModule.astro'

import { siteConfig } from '@/config'
import i18nit from '@i18n/translation'
import { i18n } from "astro:config/client";
import { getRelativeLocaleUrl } from '@utils/urlUtils'
import portfolio from '@/data/portfolio.json'
import boards from '@/data/boards.json'

export async function getStaticPaths() {
	return i18n?.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const pageTitle = t("header.works") + " - " + siteConfig.title;
const pageDescription = `${t("cover.title.works")} - ${t("cover.subTitle.works")}`;
const total = portfolio.total;
---

<MainPageLayout title={pageTitle} lang={currentLang} description={pageDescription}>
    <div class="mx-auto w-full max-w-[var(--page-width)]">
        <Cover title={t("cover.title.works")} subTitle={t("cover.subTitle.works")} />

        <!-- 分类锚点 + 排序切换 -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-10 -mt-4">
            {portfolio.categories.map((cat) => (
                <a
                    href={`#cat-${cat.name}`}
                    class="inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-md border border-[var(--button-border-color)] text-[var(--text-color)] transition duration-200 hover:border-[var(--link-color)] hover:bg-[var(--button-hover-color)]"
                >
                    {cat.name}
                    <span class="text-[var(--text-color-70)]">{cat.count}</span>
                </a>
            ))}
            <span class="hidden sm:block w-px h-5 bg-[var(--button-border-color)] mx-1"></span>
            <a href="#boards" class="inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-md border border-[var(--link-color)] text-[var(--link-color)] transition duration-200 hover:bg-[var(--button-hover-color)]">
                展板 <span>{boards.total}</span>
            </a>
            <button type="button" data-sort-btn="time" class="sort-btn">按时间</button>
            <button type="button" data-sort-btn="weight" class="sort-btn">按权重</button>
        </div>

        <!-- 展板总览：把各项目的最终展板集中一屏（数据由 script/portfolio/gen-boards.mjs 生成） -->
        <section class="mb-14">
            <h2 id="boards" class="text-2xl font-bold text-[var(--text-color)] border-b border-[var(--button-border-color)] pb-2 mb-2 scroll-mt-24">
                展板总览
                <span class="ml-2 text-base font-normal text-[var(--text-color-70)]">{boards.total}</span>
            </h2>
            <p class="text-sm text-[var(--text-color-70)] mb-6">各项目的最终展板，点进去看对应作品。</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                {boards.items.map((b) => (
                    <a
                        href={getRelativeLocaleUrl(currentLang, `/blog/${b.workSlug}/`)}
                        class="group block rounded-lg overflow-hidden border border-[var(--button-border-color)] bg-white hover:border-[var(--link-color)] transition-colors duration-300"
                        title={b.name}
                    >
                        <ImageModule src={b.file} alt={b.name} class="w-full aspect-[3/4] object-contain" />
                        <div class="px-2 py-1.5 text-xs text-[var(--text-color-70)] border-t border-[var(--button-border-color)] truncate group-hover:text-[var(--link-color)]">
                            {b.workTitle}
                        </div>
                    </a>
                ))}
            </div>
        </section>

        {portfolio.categories.map((cat) => (
            <section class="mb-14">
                <h2 id={`cat-${cat.name}`} class="text-2xl font-bold text-[var(--text-color)] border-b border-[var(--button-border-color)] pb-2 mb-6 scroll-mt-24">
                    {cat.name}
                    <span class="ml-2 text-base font-normal text-[var(--text-color-70)]">{cat.count}</span>
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" data-sort-grid>
                    {cat.works.map((work) => (
                        <a
                            href={getRelativeLocaleUrl(currentLang, `/blog/${work.slug}/`)}
                            data-w={work.weight}
                            data-d={work.doneDate}
                            class="work-card group block rounded-xl overflow-hidden border border-[var(--button-border-color)] shadow hover:border-[var(--link-color)] transition-colors duration-300"
                        >
                            <div class="relative h-40 bg-[var(--button-hover-color)] overflow-hidden">
                                {work.cover && (
                                    <ImageModule
                                        src={work.cover}
                                        alt={work.title}
                                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                    />
                                )}
                                {work.weight >= 5 && <span class="pick-badge">代表作</span>}
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold text-[var(--text-color)] group-hover:text-[var(--link-color)] transition-colors leading-snug">
                                    {work.title}
                                </h3>
                                {work.subtitle && (
                                    <p class="mt-1 text-sm text-[var(--text-color-70)] leading-relaxed line-clamp-2">{work.subtitle}</p>
                                )}
                                <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--text-color-70)]">
                                    <span>{work.doneDate}</span>
                                    <span>{work.tools.join(' / ')}</span>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        ))}

        <p class="text-center text-sm text-[var(--text-color-70)] mb-10">
            共 {total} 件作品 · 点卡片看详情
        </p>
    </div>

    <!-- fixed 浮层：留在 swup 容器内，但在淡入淡出元素之外（见 MainPageLayout 的说明） -->
    <div slot="overlay">
        <FabMenu showBackBottom={true} />
    </div>
</MainPageLayout>

<style>
    .sort-btn {
        font-size: 13px;
        padding: 6px 14px;
        border-radius: 8px;
        border: 1px solid var(--button-border-color);
        background: transparent;
        color: var(--text-color);
        cursor: pointer;
        transition: 0.2s;
    }
    .sort-btn:hover {
        border-color: var(--link-color);
        color: var(--link-color);
    }
    .sort-btn.sort-on {
        background: var(--link-color);
        border-color: var(--link-color);
        color: #fff;
    }
    .pick-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        /* ⚠️ 必须高于 1：LQIP 会给卡片图片加 position:relative + z-index:1，
           不抬高层级的话这个角标会被图片整个盖住（实测命中测试里 IMG 在 SPAN 之上） */
        z-index: 2;
        font-size: 11px;
        line-height: 1;
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--link-color);
        color: #fff;
        letter-spacing: 0.5px;
    }
</style>

<script is:inline data-swup-ignore-script>
    // 作品集排序：按完成时间倒序 / 按权重（代表作在前），选择记在 localStorage。
    // 顶栏不在 swup 容器里，但这段脚本在容器内、会被换页替换掉，所以：
    //   · 点击用 document 上的事件委托（只注册一次，永久有效）
    //   · 每次换页由 astro:page-load 重新对新 DOM 排序
    (function () {
        var KEY = 'ntfox-works-sort';

        function readMode() {
            try { return localStorage.getItem(KEY) || 'time'; } catch (e) { return 'time'; }
        }

        function applySort(mode) {
            document.querySelectorAll('[data-sort-grid]').forEach(function (grid) {
                var cards = Array.prototype.slice.call(grid.children);
                cards.sort(function (a, b) {
                    if (mode === 'weight') {
                        var dw = (+(b.dataset.w || 0)) - (+(a.dataset.w || 0));
                        if (dw) return dw;
                    }
                    return (b.dataset.d || '').localeCompare(a.dataset.d || '');
                });
                cards.forEach(function (card) { grid.appendChild(card); });
            });
            document.querySelectorAll('[data-sort-btn]').forEach(function (btn) {
                btn.classList.toggle('sort-on', btn.dataset.sortBtn === mode);
            });
        }

        document.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest ? e.target.closest('[data-sort-btn]') : null;
            if (!btn) return;
            e.preventDefault();
            var mode = btn.dataset.sortBtn;
            try { localStorage.setItem(KEY, mode); } catch (err) {}
            applySort(mode);
        });

        document.addEventListener('astro:page-load', function () { applySort(readMode()); });
        applySort(readMode());
    })();
</script>
