---
import { Icon } from "astro-icon/components";
import { profileConfig, contactConfig, visitCounterConfig } from "../config";

let introPage : string;

if (profileConfig.indexPage) {
    introPage = profileConfig.indexPage;
} else {
    introPage = import.meta.env.BASE_URL;
}
---

<!-- footer -->
<footer class="flex flex-col md:flex-row md:justify-between items-start md:items-center py-10 text-[var(--text-color-70)] max-w-[var(--header-width)] mx-auto w-full">
    <div class="mb-1 md:mb-0">
        © {profileConfig.startYear} - {new Date().getFullYear()} <a class="link-line" target="_self" href={introPage}>{profileConfig.name}</a>. 
        <!-- 访问量：数字由下面的脚本填。服务不可用时整段保持 hidden（不显示「-」）。 -->
        {visitCounterConfig.enable && (
            <span
                id="visit-counter"
                class="visit-counter hidden"
                data-api={visitCounterConfig.apiUrl}
                data-site={visitCounterConfig.reportAs}
                data-domains={visitCounterConfig.domains.join(",")}
            >
                <span class="sep">·</span><span id="visit-counter-value"></span>
            </span>
        )}
    </div>
    <div class="right">
        <p>
        <!-- 联系方式：邮箱可点开写邮件，微信号鼠标悬停可见（改 src/config.ts 的 contactConfig） -->
        <a href={`mailto:${contactConfig.email}`} title={contactConfig.email} class="tooltip-wrapper"><Icon name="fa6-solid:envelope" class="inline-block" /></a>
        <span class="tooltip-wrapper" title={`微信：${contactConfig.wechat}`}><Icon name="simple-icons:wechat" class="inline-block" /></span>
        |
        Powered by 
        <a target="_blank" href="https://astro.build" title="Astro" class="tooltip-wrapper"><Icon name="simple-icons:astro" class="inline-block" /></a> 
        <a target="_blank" href="https://svelte.dev/" title="Svelte" class="tooltip-wrapper"><Icon name="simple-icons:svelte" class="inline-block"/></a> 
        <a target="_blank" href="https://tailwindcss.com/" title="tailwindcss" class="tooltip-wrapper"><Icon name="simple-icons:tailwindcss" class="inline-block"/></a> 
        <!-- 想挂自己的 GitHub 就在这一行加一个 <a>，图标名见 astro-icon 的 simple-icons 集合 -->
        | 
        <a href="/rss.xml" target="_self" title="RSS" class="tooltip-wrapper"><Icon name="simple-icons:rss" class="inline-block" /></a>
        </p>
    </div>
</footer>

<!-- 访问量计数器（第三方服务，配置在 src/config.ts 的 visitCounterConfig）。
     只显示访客总数（UV）；三个地址（正式域名 / pages.dev / github.io）共用一份计数。
     data-swup-ignore-script：页脚在 swup 容器之外、换页不会重建，但 swup 会把文档里的
     内联脚本重放一遍，重放会重复绑定监听 → 用属性 + window 守卫双重保险。
     计数时机：首次加载跑一次，之后每次换页（astro:page-load）再跑一次；
     同一个网址连续重复触发只算一次（last 去重），避免重复计数。 -->
<script is:inline data-swup-ignore-script>
    (() => {
        const box = document.getElementById('visit-counter');
        if (!box || window.__visitCounterWired) return;
        const valueEl = document.getElementById('visit-counter-value');
        const api = box.dataset.api;
        if (!api || !valueEl) return;

        // 只在白名单域名显示（不在名单里的镜像既不显示也不上报，避免污染统计）
        const domains = (box.dataset.domains || '').split(',').map((s) => s.trim()).filter(Boolean);
        if (domains.length && !domains.includes(location.hostname)) return;

        window.__visitCounterWired = true;

        // 三个地址共用一份计数：不管从哪个域名进来，都按正式域名（data-site）上报。
        // 服务端按上报网址的 host 记账，所以镜像站与正式域名看到的是同一个数字。
        const site = (box.dataset.site || '').replace(/\/+$/, '');
        const target = () => (site ? site + location.pathname + location.search : location.href);

        // UV 去重用的 cookie 名按**正式域名的 host** 命名（与服务商同名同规则）。
        // ⚠️ cookie 跨不了域名：同一个人分别从 204041.xyz 和 pages.dev 进来会被算两次 UV，
        //    这是浏览器 cookie 的固有限制，除非以后自己有后端。PV 不受影响，是合在一起的。
        let uvHost = location.host || 'unknown-host';
        try { if (site) uvHost = new URL(site).host; } catch (err) {}
        const uvKey = 'vercount_uv_' + uvHost.replace(/[^a-zA-Z0-9_-]/g, '_');
        const fmt = (n) => Number(n || 0).toLocaleString('en-US');
        let last = '';

        const count = async (url) => {
            try {
                const isNewUv = document.cookie.split('; ').indexOf(uvKey + '=1') === -1;
                if (isNewUv) {
                    document.cookie = uvKey + '=1; path=/; max-age=31536000; samesite=lax';
                }
                const res = await fetch(api, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url, isNewUv }),
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const json = await res.json();
                const d = (json && (json.data || json)) || {};
                // 只显示访客总数（UV）：三个地址合一份账，同一个人只算一次
                valueEl.textContent = '访客 ' + fmt(d.site_uv) + ' 人';
                box.title = '本站累计访客数（同一浏览器只算一次）';
                box.classList.remove('hidden');
            } catch (err) {
                // 统计服务不可用（被墙 / 离线 / 限流）：静默隐藏，不影响页面
            }
        };

        const run = () => {
            const url = target();
            if (url === last) return; // 同一页连续重复触发（首屏 + 换页兜底）只算一次
            last = url;
            count(url);
        };

        run();
        document.addEventListener('astro:page-load', run);
    })();
</script>


<style>
    footer {
        font-family:  "EB Garamond", cursive !important; 
    }

    /* 访问量：没拿到数字前整块隐藏（不显示「-」或 0） */
    .visit-counter.hidden {
        display: none;
    }

    .visit-counter .sep {
        margin: 0 0.35em;
        opacity: 0.6;
    }
   .right a {
        color: inherit;
        /* transition: color 0.3s ease; */
        text-decoration: none;
        position: relative;
        display: inline-block;
    }
    
    .right a:hover {
        color: var(--link-color);
    }
    
    .tooltip-wrapper {
        position: relative;
        display: inline-block;
    }

    .tooltip-wrapper:hover::after {
        content: attr(title);
        position: absolute;
        bottom: 80%;
        left: 50%;
        transform: translateX(-50%);
        padding: 4px 8px;
        background-color: var(--text-color);
        color:var(--bg-color);
        font-size: 12px; 
        font-weight: bold;
        border-radius: 6px;
        white-space: nowrap;
        z-index: 1000;
        opacity: 0;
        animation: fadeInTooltip 0.3s forwards;
        margin-bottom: 5px;
        text-align: center;
    }

    /* 隐藏浏览器默认的title提示 */
    .tooltip-wrapper {
        text-decoration: none !important;
        margin: 0 2px;
    }

    .tooltip-wrapper:hover {
        outline: none !important;
        border: none !important;
    }

    @keyframes fadeInTooltip {
        to {
            opacity: 1;
        }
    }
</style>