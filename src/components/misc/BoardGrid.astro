---
// 各项目的最终展板总览（数据由 script/portfolio/gen-boards.mjs 生成）
import ImageModule from '@components/misc/ImageModule.astro'
import { getRelativeLocaleUrl } from '@utils/urlUtils'
import boards from '@/data/boards.json'

interface Props {
    lang: string
}
const { lang } = Astro.props
---

<div class="mt-10">
    <h3 class="text-lg font-semibold text-[var(--text-color)] mb-2">各项目的最终展板</h3>
    <p class="text-sm text-[var(--text-color-70)] mb-5">所有项目的展板本身，点图进对应作品。</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {boards.items.map((b) => (
            <a
                href={getRelativeLocaleUrl(lang, `/blog/${b.workSlug}/`)}
                class="group block rounded-lg overflow-hidden border border-[var(--button-border-color)] bg-white hover:border-[var(--link-color)] transition-colors duration-300"
                title={b.name}
            >
                <ImageModule src={b.file} alt={b.name} class="w-full aspect-[3/4] object-contain" />
                <div class="px-2 py-1.5 text-xs text-[var(--text-color-70)] border-t border-[var(--button-border-color)] truncate group-hover:text-[var(--link-color)]">
                    {b.workTitle}
                </div>
            </a>
        ))}
    </div>
</div>
